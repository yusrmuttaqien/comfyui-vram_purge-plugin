{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "baseUrl": ".",
    "paths": {
      "/scripts/app.js": ["types/scripts-app.d.ts"],
      "/scripts/api.js": ["types/scripts-api.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
